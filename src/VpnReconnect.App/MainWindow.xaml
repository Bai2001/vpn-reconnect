<Window x:Class="VpnReconnect.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="公司 VPN 重连"
        Height="600"
        Width="820"
        MinHeight="460"
        MinWidth="560"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Foreground="{StaticResource TextPrimaryBrush}"
        Background="{StaticResource AppBackgroundBrush}"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <TabControl>
        <TabItem Header="状态">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,20,20">
                    <!-- 主状态 -->
                    <Border Style="{StaticResource Card}" Padding="18,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StatusBar" Width="5" CornerRadius="2.5" Background="{StaticResource IdleBrush}" Margin="0,3,14,3" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="ConnectedText" Text="尚未检查" FontSize="25" FontWeight="SemiBold" />
                                <TextBlock x:Name="StatusSubText" Style="{StaticResource Hint}" Margin="0,5,0,0" Text="正在获取状态…" />
                            </StackPanel>
                            <Border x:Name="StatusBadge" Grid.Column="2" CornerRadius="20" Padding="12,5" Background="#F3F4F6" VerticalAlignment="Center">
                                <TextBlock x:Name="StatusBadgeText" Text="待检查" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- 详情 -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="隧道地址" Style="{StaticResource FieldLabel}" Margin="0,0,12,10" />
                            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="Ipv4Text" Text="无" Style="{StaticResource ValueText}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="判定依据" Style="{StaticResource FieldLabel}" Margin="0,0,12,10" />
                            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TargetText" Style="{StaticResource ValueText}" Margin="0,0,0,10" />
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="认证状态" Style="{StaticResource FieldLabel}" Margin="0,0,12,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AuthText" Style="{StaticResource ValueText}" />
                        </Grid>
                    </Border>

                    <!-- 最近动作 -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="最近动作" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="RecentTimeText" Text="" HorizontalAlignment="Right" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                            </Grid>
                            <TextBlock x:Name="RecentStepText" Style="{StaticResource ValueText}" FontWeight="SemiBold" Text="尚未检查" />
                            <TextBlock x:Name="RecentEvidenceText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- 操作 -->
                    <WrapPanel Margin="0,16,0,0">
                        <Button x:Name="CheckNowButton" Content="立即检查" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="CheckNow_Click" />
                        <Button Content="隐藏到后台" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="Hide_Click" />
                        <Button Content="退出程序" Style="{StaticResource DangerButton}" Margin="0,0,8,8" Click="Exit_Click" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0"
                               Text="关闭窗口不会退出程序：程序会在托盘继续按间隔检查，自动重连断线。" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="设置">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20,18,20,20">
                    <!-- VPN 连接 -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="VPN 连接" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,5,0,10"
                                       Text="选中哪个适配器，它的名字就是拨号用的 VPN 名，同时用来判断是否拿到了地址。注意：断线时公司适配器会从列表消失，请趁着能连上时先选一次并保存。" />
                            <ListBox x:Name="AdapterList" Height="152" DisplayMemberPath="Display" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="刷新适配器" Style="{StaticResource SecondaryButton}" MinWidth="0" Click="RefreshAdapters_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- 账号与判定 -->
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="账号与判定" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="88" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="用户名" Style="{StaticResource FieldLabel}" Margin="0,0,12,8" />
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="UsernameBox" Margin="0,0,0,8" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="密码" Style="{StaticResource FieldLabel}" Margin="0,0,12,4" />
                                <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="PasswordHint" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="密码框不回显已存密码，留空则不修改" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="目标地址" Style="{StaticResource FieldLabel}" Margin="0,0,12,4" />
                                <TextBox Grid.Row="3" Grid.Column="1" x:Name="TargetBox" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource Hint}" Margin="0,0,0,10"
                                           Text="可选。填了以 ping 通为准（例如 192.168.4.100）；留空则只看所选适配器有没有拿到有效 IPv4。" />

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="检查间隔" Style="{StaticResource FieldLabel}" Margin="0,0,12,8" />
                                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBox x:Name="IntervalBox" Text="60" Width="86" />
                                    <TextBlock Text="秒（15 - 600）" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="开机启动" Style="{StaticResource FieldLabel}" Margin="0,0,12,8" />
                                <CheckBox Grid.Row="6" Grid.Column="1" x:Name="StartOnLoginBox" Content="登录 Windows 后静默启动（只在托盘，不弹窗口）" Margin="0,0,0,4" />
                                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="StartupStatusText" Style="{StaticResource Hint}" Margin="0,0,0,8" Text="" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <WrapPanel Margin="0,16,0,0">
                        <Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="Save_Click" />
                    </WrapPanel>
                    <TextBlock x:Name="SettingsMessage" Style="{StaticResource Hint}" Margin="0,2,0,0" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <TabItem Header="日志">
            <DockPanel Margin="20,16,20,16">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="运行日志" Style="{StaticResource SectionTitle}" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="LogCountText" Style="{StaticResource Hint}" Margin="10,0,0,0" VerticalAlignment="Center" Text="" />
                    </StackPanel>
                    <CheckBox x:Name="OnlyProblemsCheck" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Content="只看异常" Checked="OnlyProblems_Changed" Unchecked="OnlyProblems_Changed" />
                </Grid>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <Button Content="刷新" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="RefreshLog_Click" />
                    <Button Content="导出" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="ExportLog_Click" />
                    <Button Content="清空" Style="{StaticResource DangerButton}" Margin="0,0,8,8" Click="ClearLog_Click" />
                    <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="4,0,0,8" Text="最新的在最上面；界面只显示最近 500 条，更早的用「导出」查看；日志自动保留 7 天或 5 MB。" />
                </WrapPanel>
                <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
                    <DataGrid x:Name="LogGrid"
                              RowHeight="32"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                        <Setter Property="FontFamily" Value="Consolas, Microsoft YaHei UI" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="步骤" Binding="{Binding Step}" Width="88">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="96">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{Binding ResultBrush}" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="依据" Binding="{Binding Evidence}" Width="*" MinWidth="180">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="VerticalAlignment" Value="Center" />
                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        <Setter Property="ToolTip" Value="{Binding Evidence}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
