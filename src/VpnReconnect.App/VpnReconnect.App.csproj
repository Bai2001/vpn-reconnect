<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VpnReconnect.App</RootNamespace>
    <AssemblyName>VpnReconnect</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyTitle>公司 VPN 重连</AssemblyTitle>
    <Product>公司 VPN 重连</Product>
    <Description>定时检查公司 VPN，断线自动重连</Description>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms 仅用于托盘图标，避免与 WPF 的同名类型冲突 -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\*.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VpnReconnect.Core\VpnReconnect.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>
</Project>
